{
  "manifest_version": 1,
  "id": "nskry-record",
  "name": "Screen recording",
  "toolbar_label_zh_cn": "录屏",
  "toolbar_icon": [[[2,4],[10,4],[10,12],[2,12],[2,4]],[[10,7],[14,5],[14,11],[10,9]],[[6,6.6],[7,7],[7.4,8],[7,9],[6,9.4],[5,9],[4.6,8],[5,7],[6,6.6]]],
  "version": "0.5.0",
  "author": "Nskry Team",
  "description": "MP4/H.264 or separate GIF recording; optional window follow, 30/60 fps video presets, post-record save/copy and trim. Optional MP4 audio from an application or output device.",
  "runtime": {"entry": "nskry-record.dll", "architecture": "x64", "api_version": 2, "load_policy": "on_demand"},
  "capabilities": ["toolbar_action"],
  "extensions": {"commands": 1, "region_capture": 2, "capture_actions": 1, "settings_ui":1},
  "capture_actions": [{
    "id":"gif", "label":"Record GIF", "label_zh_cn":"录制 GIF",
    "toolbar_icon": [[[2,3],[14,3],[14,13],[2,13],[2,3]],[[5,5],[5,11]],[[11,5],[11,11]],[[7,6],[9.5,8],[7,10],[7,6]]]
  }],
  "shortcuts": [
    {"id":"launch", "label":"Start recording a selected region", "scope":"capture", "default":"", "general_jump":true},
    {"id":"stop", "label":"Stop recording and save", "scope":"command", "default":"", "general_jump":true},
    {"id":"pause_resume", "label":"Pause or resume recording", "scope":"command", "default":"", "general_jump":true}
  ],
  "compatibility": {"nskry_min":"0.5.0", "nskry_max":null},
  "source": {"homepage":"https://github.com/GuanT0u/Nskry", "repository":"https://github.com/GuanT0u/Nskry"}
}
