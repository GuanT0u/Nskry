{
  "manifest_version": 1,
  "id": "nskry-translate",
  "name": "Translation (experimental)",
  "version": "0.3.2",
  "author": "Nskry Team",
  "description": "On-demand English/Chinese translation: offline, configured OpenAI/LibreTranslate, or optional free online. Online text upload requires confirmation; no OCR plugin dependency.",
  "runtime": {"entry":"nskry-translate.dll","architecture":"x64","api_version":2,"load_policy":"on_demand"},
  "capabilities": ["toolbar_action", "post_capture"],
  "extensions": {"settings_ui": 1, "text_translation": 1, "image_recognition_client": 1},
  "shortcuts": [{"id":"launch","label":"Translate a selected region","scope":"capture","default":"","general_jump":true}],
  "compatibility": {"nskry_min":"0.5.0","nskry_max":null},
  "source": {"homepage":"https://github.com/GuanT0u/Nskry","repository":"https://github.com/GuanT0u/Nskry"}
}
