{
  "manifest_version": 1,
  "id": "nskry-ocr",
  "name": "Text recognition",
  "version": "0.6.0",
  "author": "Nskry Team",
  "description": "On-demand offline Chinese and English text recognition, with a lightweight Windows OCR option.",
  "runtime": {
    "entry": "nskry-ocr.dll",
    "architecture": "x64",
    "api_version": 2,
    "load_policy": "on_demand"
  },
  "capabilities": ["toolbar_action", "post_capture"],
  "compatibility": { "nskry_min": "0.5.0", "nskry_max": null },
  "source": { "homepage": "https://github.com/GuanT0u/Nskry", "repository": "https://github.com/GuanT0u/Nskry" }
}
