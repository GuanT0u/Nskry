<script>
  import { arcaneAudio } from '../lib/arcane-audio';

  // Interactive Lens Dragging Engine
  const lens = document.getElementById('brass-lens');
  const stage = document.getElementById('desktop-stage');
  const lensCoords = document.getElementById('lens-coords');
  const presetButtons = document.querySelectorAll<HTMLButtonElement>('.btn-preset');
  const btnPin = document.getElementById('btn-pin-viewport');
  const pinnedMirror = document.getElementById('pinned-mirror');
  const pinnedCloseBtn = document.getElementById('pinned-close-btn');

  let isDragging = false;
  let startX = 0;
  let startY = 0;
  let lensX = 80;
  let lensY = 50;

  function updateLensPosition(x: number, y: number) {
    if (!stage || !lens) return;
    const maxX = stage.clientWidth - lens.clientWidth;
    const maxY = stage.clientHeight - lens.clientHeight;

    lensX = Math.max(0, Math.min(maxX, x));
    lensY = Math.max(0, Math.min(maxY, y));

    lens.style.left = `${lensX}px`;
    lens.style.top = `${lensY}px`;

    if (lensCoords) {
      lensCoords.textContent = `LENS: [X: ${Math.round(lensX)}, Y: ${Math.round(lensY)}] · 144 FPS`;
    }
  }

  if (lens && stage) {
    lens.addEventListener('pointerdown', (e) => {
      isDragging = true;
      startX = e.clientX - lensX;
      startY = e.clientY - lensY;
      lens.setPointerCapture(e.pointerId);
      arcaneAudio.playBrassClick();
    });

    lens.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const newX = e.clientX - startX;
      const newY = e.clientY - startY;
      updateLensPosition(newX, newY);
    });

    lens.addEventListener('pointerup', (e) => {
      if (isDragging) {
        isDragging = false;
        lens.releasePointerCapture(e.pointerId);
        arcaneAudio.playBrassClick();
      }
    });

    // Preset Target Buttons
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const target = btn.dataset.target;
        arcaneAudio.playBrassClick();

        if (target === 'term') {
          updateLensPosition(50, 40);
        } else if (target === 'radar') {
          updateLensPosition(stage.clientWidth - 240, 50);
        } else if (target === 'media') {
          updateLensPosition(140, stage.clientHeight - 200);
        }
      });
    });

    // Pin Viewport Action
    if (btnPin && pinnedMirror) {
      btnPin.addEventListener('click', () => {
        arcaneAudio.playArcaneChime(659.25);
        pinnedMirror.style.display = 'block';
      });
    }

    if (pinnedCloseBtn && pinnedMirror) {
      pinnedCloseBtn.addEventListener('click', () => {
        arcaneAudio.playBrassClick();
        pinnedMirror.style.display = 'none';
      });
    }
  }
</script>
