      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .act3-container {
      padding: 70px 16px 100px;
    }
    .spell-rack-titlebar {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .preset-buttons {
      flex-direction: column;
      width: 100%;
    }
    .preset-buttons .btn-brass-rune {
      width: 100%;
      justify-content: center;
    }
    .spell-slots-grid {
      grid-template-columns: 1fr;
    }
