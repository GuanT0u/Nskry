</style>

<script>
  import { arcaneAudio } from '../lib/arcane-audio';

  interface GemData {
    id: string;
    weight: number;
    name: string;
    school: string;
    desc: string;
    hotkey: string;
    freq: number;
  }

  const GEMS_MAP: Record<string, GemData> = {
    pin: {
      id: 'pin',
      weight: 1.40,
      name: '凝滞术 (Live Region Pinning)',
      school: '空间系 / Transmutation',
      desc: '将屏幕任意子区域凝固为可交互的浮动灵镜。Direct3D/WGC 微秒级低时延推流，支持无焦点点击穿透与半透明调谐。',
      hotkey: 'Alt + P',
      freq: 659.25 // E5
    },
    ocr: {
      id: 'ocr',
      weight: 4.20,
      name: '启智识文 (Neural Offline OCR)',
      school: '预言系 / Divination',
      desc: '端侧轻量神经离线感知，毫秒级解析多语种图文、代码块与数学公式。严守隐私天机，0 字节网络上报，断网亦能明辨秋毫。',
      hotkey: 'Alt + O',
      freq: 783.99 // G5
    },
    scroll: {
      id: 'scroll',
      weight: 2.10,
      name: '延绵卷轴 (Bidirectional Long Scroll)',
      school: '时空系 / Conjuration',
      desc: '纵览长卷秘术。自研特征点特征匹配与启发式去重拼缝算法，轻松捕捉超长聊天记录、百万行代码与无限网页，无惧吸顶浮动栏干扰。',
      hotkey: 'Alt + S',
      freq: 880.00 // A5
    },
    record: {
      id: 'record',
      weight: 3.80,
      name: '时光留影 (Lite Screen Recording)',
      school: '塑能系 / Evocation',
      desc: '硬件编码极速捕获，微秒级帧队列调度。录制丝滑 60/120 FPS 高清演示与短 GIF，仅在按下快门时唤醒算力，闲置期间绝对零 CPU 消耗。',
      hotkey: 'Alt + R',
      freq: 1046.50 // C6
    }
  };

  const BASE_WEIGHT = 8.24;
  const BLOATED_BASELINE = 240.0;

  function initSpellSlots() {
    const slots = document.querySelectorAll<HTMLElement>('.spell-card-slot');
    const activeSlotsCount = document.getElementById('active-slots-count');
    const nscryTotalMb = document.getElementById('nscry-total-mb');
    const nscryBar = document.getElementById('nscry-bar');
    const efficiencyPercent = document.getElementById('efficiency-percent');

    // Drawer elements
    const detailName = document.getElementById('detail-name');
    const detailSchool = document.getElementById('detail-school');
    const detailDesc = document.getElementById('detail-desc');
    const detailHotkey = document.getElementById('detail-hotkey');

    // Memory breakdown rows
    const pinRow = document.querySelector<HTMLElement>('.breakdown-item.pin-line');
    const ocrRow = document.querySelector<HTMLElement>('.breakdown-item.ocr-line');
    const scrollRow = document.querySelector<HTMLElement>('.breakdown-item.scroll-line');
    const recordRow = document.querySelector<HTMLElement>('.breakdown-item.record-line');

    const breakdownRows: Record<string, HTMLElement | null> = {
      pin: pinRow,
      ocr: ocrRow,
      scroll: scrollRow,
      record: recordRow
    };

    function updateTelemetry() {
      let activeCount = 0;
      let totalWeight = BASE_WEIGHT;

      slots.forEach((slot) => {
        const gemKey = slot.dataset.gem;
        const isActive = slot.classList.contains('active');
        const statusPill = slot.querySelector('.slot-status-pill');

        if (statusPill) {
          statusPill.textContent = isActive ? 'ACTIVE' : 'DORMANT';
        }
        slot.setAttribute('aria-pressed', isActive ? 'true' : 'false');

        const row = gemKey ? breakdownRows[gemKey] : null;

        if (isActive && gemKey && GEMS_MAP[gemKey]) {
          activeCount++;
          totalWeight += GEMS_MAP[gemKey].weight;
          if (row) {
            row.classList.remove('is-dormant');
            const valEl = row.querySelector('.b-val');
            if (valEl) valEl.textContent = `+${GEMS_MAP[gemKey].weight.toFixed(2)} MB`;
          }
        } else if (row) {
          row.classList.add('is-dormant');
          const valEl = row.querySelector('.b-val');
          if (valEl) valEl.textContent = '未装配 (0 MB)';
        }
      });

      if (activeSlotsCount) {
        activeSlotsCount.textContent = `EQUIPPED SLOTS: ${activeCount} / 4`;
      }

      if (nscryTotalMb) {
        nscryTotalMb.textContent = totalWeight.toFixed(2);
      }

      if (nscryBar) {
        // Percentage relative to 240 MB bloated baseline
        const pct = Math.min(100, (totalWeight / BLOATED_BASELINE) * 100);
        nscryBar.style.width = `${pct.toFixed(2)}%`;
      }

      if (efficiencyPercent) {
        const eff = ((totalWeight / BLOATED_BASELINE) * 100).toFixed(1);
        efficiencyPercent.textContent = `${eff}% of bloated suites`;
      }
    }

    function selectGemDetails(gemKey: string) {
      const data = GEMS_MAP[gemKey];
      if (!data) return;

      if (detailName) detailName.textContent = data.name;
      if (detailSchool) detailSchool.textContent = data.school;
      if (detailDesc) detailDesc.textContent = data.desc;
      if (detailHotkey) detailHotkey.textContent = data.hotkey;
    }

    function toggleSlot(slot: HTMLElement) {
      const gemKey = slot.dataset.gem;
      if (!gemKey || !GEMS_MAP[gemKey]) return;

      const wasActive = slot.classList.contains('active');
      const nowActive = !wasActive;

      if (nowActive) {
        slot.classList.add('active');
        arcaneAudio.playCrystalChime(GEMS_MAP[gemKey].freq);
      } else {
        slot.classList.remove('active');
        arcaneAudio.playBrassClick();
      }

      selectGemDetails(gemKey);
      updateTelemetry();
    }

    // Bind slot click and enter key
    slots.forEach((slot) => {
      slot.addEventListener('click', () => toggleSlot(slot));
      slot.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleSlot(slot);
        }
      });
      slot.addEventListener('mouseenter', () => {
        const gemKey = slot.dataset.gem;
        if (gemKey) selectGemDetails(gemKey);
      });
    });

    // Preset Buttons
    const presetButtons = document.querySelectorAll<HTMLButtonElement>('.preset-buttons button');
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        arcaneAudio.playBrassClick();

        const preset = btn.dataset.preset;
        if (preset === 'minimal') {
          // Only Pin
          slots.forEach((slot) => {
            const k = slot.dataset.gem;
            if (k === 'pin') slot.classList.add('active');
            else slot.classList.remove('active');
          });
          selectGemDetails('pin');
        } else if (preset === 'scholar') {
          // Pin + OCR
          slots.forEach((slot) => {
            const k = slot.dataset.gem;
            if (k === 'pin' || k === 'ocr') slot.classList.add('active');
            else slot.classList.remove('active');
          });
          selectGemDetails('ocr');
        } else if (preset === 'archmage') {
          // All 4
          slots.forEach((slot) => slot.classList.add('active'));
          selectGemDetails('record');
        }

        updateTelemetry();
      });
    });

    // Initial update
    updateTelemetry();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSpellSlots);
  } else {
    initSpellSlots();
  }
</script>
