  .ring-cyan { border-color: rgba(56, 189, 248, 0.5); box-shadow: 0 0 16px rgba(56, 189, 248, 0.3); }
  .ring-purple { border-color: rgba(192, 132, 252, 0.5); box-shadow: 0 0 16px rgba(192, 132, 252, 0.3); }
  .ring-amber { border-color: rgba(251, 191, 36, 0.5); box-shadow: 0 0 16px rgba(251, 191, 36, 0.3); }
  .ring-crimson { border-color: rgba(248, 113, 113, 0.5); box-shadow: 0 0 16px rgba(248, 113, 113, 0.3); }

  .slot-meta {
