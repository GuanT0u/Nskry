  }

  .glow-cyan { background: radial-gradient(circle, #38bdf8 0%, #0284c7 60%, transparent 100%); }
  .glow-purple { background: radial-gradient(circle, #c084fc 0%, #7e22ce 60%, transparent 100%); }
  .glow-amber { background: radial-gradient(circle, #fbbf24 0%, #d97706 60%, transparent 100%); }
  .glow-crimson { background: radial-gradient(circle, #f87171 0%, #b91c1c 60%, transparent 100%); }

  .socket-rune-ring {
    position: absolute;
